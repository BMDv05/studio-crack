# Copy to .env and adjust. All values have safe defaults for local review.
PORT=3100
SITE_BASE_URL=http://localhost:3100
STUDIO_EMAIL=studio@doubleh.example
STUDIO_REPLY_FROM="Double H Studio <no-reply@doubleh.example>"
STUDIO_TIMEZONE=Asia/Amman
# Comma-separated list shown in the booking dropdown. Keep in sync with public/book.html.
STUDIO_SERVICES=Brand Identity & Logo,Architectural Visualization,Interior & Spatial Design,Cinematic Video & Showreel,Web & Digital Presence
# Expected response time quoted in the client acknowledgment email.
STUDIO_RESPONSE_SLA=within 2 working days
# Optional SMTP for real delivery. If unset, emails are logged to ./emails/ and console.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# Token guarding legacy export (kept for compat; dashboard uses session auth).
ADMIN_TOKEN=change-me

# ---- Admin dashboard ----
ADMIN_EMAIL=studio-admin@example.com
ADMIN_PASSWORD=change-me-to-10-chars-min
ADMIN_NAME=Studio Admin
ADMIN_SESSION_MINUTES=30
# Set true when serving HTTPS so cookies are Secure.
# SECURE_COOKIES=false

# ---- Video uploads ----
# Max single video size in MB (also editable in Settings).
MAX_UPLOAD_MB=500
# Local disk (default) or object storage with signed direct uploads.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# S3-compatible object storage (AWS S3, Cloudflare R2, ...).
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=doubleh-videos
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE=https://cdn.example.com/studio

# Cloudflare Workers static assets — response headers for this site.
#
# Workers serve assets with `Cache-Control: public, max-age=0, must-revalidate`
# and no security headers at all, because this project serves the document and
# its assets straight from the asset binding instead of through Express. The
# rules below override that default. They are parsed by Cloudflare at upload
# time (never served as a file), and they do not affect /api or /media, whose
# responses are generated by the Worker.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data:; connect-src 'self' https://nxtxhaddmhypzqaobrqc.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests

# The dashboard is private to the studio; keep it out of search results even
# before the client-side meta tag is parsed.
/admin*
  X-Robots-Tag: noindex
  Cache-Control: no-store

# Vite puts a content hash in every filename here, so a given URL never changes
# its bytes. One year, immutable: repeat visits skip the revalidation round trip
# that used to re-check the 1.3 MB entry bundle on every navigation.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Large media, replaced only deliberately. A day keeps repeat visits free while
# still picking up a re-encoded file the next day.
/video/*
  Cache-Control: public, max-age=86400

/hero/*
  Cache-Control: public, max-age=86400

# The studio's scanned surface textures; replaced only with the scene itself.
/textures/*
  Cache-Control: public, max-age=86400

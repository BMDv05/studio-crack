{
  "name": "double-h-studio",
  "version": "1.0.0",
  "description": "Double H Studio — React 18 + Vite frontend, Node/Express/PostgreSQL backend",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "test": "npm --prefix server test",
    "db:up": "docker compose up -d db",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:seed": "npm --prefix server run db:seed",
    "import:legacy": "npm --prefix server run import:legacy"
  },

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://doubleh:doubleh@127.0.0.1:5434/doubleh"

# --- Server ---
PORT=3100
CLIENT_ORIGIN=http://localhost:5173
SECURE_COOKIES=false

# --- Admin seed (first admin only; no public sign-up) ---
ADMIN_EMAIL=studio-admin@example.com
ADMIN_PASSWORD=change-me-to-10-chars-min
ADMIN_NAME=Studio Admin
ADMIN_SESSION_MINUTES=30

# --- Studio ---
STUDIO_EMAIL=studio@doubleh.example
STUDIO_REPLY_FROM="Double H Studio <no-reply@doubleh.example>"
STUDIO_TIMEZONE=Asia/Amman
STUDIO_SERVICES=Brand Identity & Logo,Architectural Visualization,Interior & Spatial Design,Cinematic Video & Showreel,Web & Digital Presence
STUDIO_RESPONSE_SLA=within 2 working days

# --- Email delivery (unset = log only, never fail a booking) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# --- Video uploads ---
MAX_UPLOAD_MB_PRODUCTION=500
MAX_UPLOAD_MB_SOCIAL=200
MAX_SOCIAL_SEC=90
UPLOAD_DIR=uploads
STORAGE_DRIVER=local

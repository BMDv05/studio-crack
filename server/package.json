{
  "name": "double-h-studio-server",
  "version": "1.0.0",
  "description": "Double H Studio API — Express + PostgreSQL + Prisma",
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "pretest": "node scripts/ensure-test-db.cjs",
    "test": "node --test --test-concurrency=1 tests/booking.test.js tests/admin.test.js tests/videos.test.js",
    "seed": "node prisma/seed.cjs",
    "admin:set": "node scripts/set-admin.cjs",
    "import:legacy": "node scripts/import-legacy.cjs",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^8.0.0",
    "nodemailer": "^6.9.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "private": true,
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
